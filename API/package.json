{
  "name": "extra-hour-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/serve.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/serve.js",
    "start:dev": "nodemon --exec \"node --env-file=.env --import tsx\" serve.ts",
    "migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "api_up": "./api_up.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/jwt": "^10.2.7",
    "bcrypt": "^6.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "mariadb": "^3.5.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
